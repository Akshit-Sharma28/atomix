generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  GOVERNANCE_TEAM
  VALIDATOR
  QA_REVIEWER
  REVIEWER
  RETESTER
  EXECUTIVE
  PROJECT_MANAGER
  ENGAGEMENT_MANAGER
  CONSULTANT
  SECURITY_LEAD
  DEVELOPER
  VIEWER
}

model User {
  id String @id @default(cuid())

  name  String
  email String @unique

  role Role @default(REVIEWER)

  isActive Boolean @default(true)
  reviewerPool String @default("Augmentation")

  createdAt DateTime @default(now())

  assignedFindings Finding[] @relation("FindingOwner")
  reviewerProfile  ReviewerProfile?
  reviewAssignments ReviewerAssignment[] @relation("AssignmentUser")
  ownedTasks Task[] @relation("TaskOwner")
  ownedRemediationPlans RemediationPlan[] @relation("RemediationPlanOwner")
  managedProjects Project[] @relation("ProjectManager")
  validatedProjects Project[] @relation("ProjectValidator")
  appSessions      AppSession[]
  recruitedInterviewProfiles InterviewProfile[] @relation("InterviewRecruiter")
  managedInterviewProfiles InterviewProfile[] @relation("InterviewHiringManager")
  ownedInterviewRounds InterviewRound[] @relation("InterviewOwner")
  primaryInterviewRounds InterviewRound[] @relation("PrimaryInterviewer")
  secondaryInterviewRounds InterviewRound[] @relation("SecondaryInterviewer")
  observedInterviewRounds InterviewRound[] @relation("ObserverInterviewer")
  ownedInterviewActions InterviewAction[] @relation("InterviewActionOwner")

  accounts Account?
}

model Project {
  id String @id @default(cuid())

  sprId String? @unique

  name   String
  client String?

  executiveSummary String?

  status String @default("Active")
  riskTier String?
  businessOwner String?
  technicalOwner String?
  projectManagerId String?
  validatorId String?

  projectManager User? @relation("ProjectManager", fields: [projectManagerId], references: [id])
  validator User? @relation("ProjectValidator", fields: [validatorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  findings      Finding[]
  tasks         Task[]
  components    Component[]
  scopeProfiles ScopeProfile[]
  reviews       SecurityReview[]
}

model Finding {
  id String @id @default(cuid())

  title    String
  severity String

  source String

  status String @default("Open")

  ownerId String?

  owner User? @relation("FindingOwner", fields: [ownerId], references: [id])

  dueDate DateTime?

  slaDays Int?

  description String?
  remediation String?

  verified Boolean @default(false)

  cvssScore  Float?
  cvssVector String?

  cweId         String?
  owaspCategory String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  projectId String
  reviewId String?
  componentId String?
  canonicalFindingId String?

  project Project @relation(fields: [projectId], references: [id])
  review SecurityReview? @relation(fields: [reviewId], references: [id])
  component Component? @relation(fields: [componentId], references: [id])
  canonicalFinding Finding? @relation("FindingVersions", fields: [canonicalFindingId], references: [id])
  versions Finding[] @relation("FindingVersions")

  analysis FindingAnalysis?

  activities FindingActivity[]
  tasks Task[]
  riskExceptions RiskException[]
  remediationPlan RemediationPlan?
}

model Task {
  id String @id @default(cuid())

  title  String
  status String @default("Open")

  dueDate DateTime?

  projectId String
  findingId String?
  remediationPlanId String?
  ownerId String?

  project Project @relation(fields: [projectId], references: [id])
  finding Finding? @relation(fields: [findingId], references: [id])
  remediationPlan RemediationPlan? @relation(fields: [remediationPlanId], references: [id])
  owner User? @relation("TaskOwner", fields: [ownerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Component {
  id String @id @default(cuid())

  projectId String
  parentId String?

  name String
  type String @default("APPLICATION")
  description String?
  criticality String @default("Medium")

  project Project @relation(fields: [projectId], references: [id])
  parent Component? @relation("ComponentTree", fields: [parentId], references: [id])
  children Component[] @relation("ComponentTree")

  findings Finding[]
  scopeItems ScopeItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ScopeProfile {
  id String @id @default(cuid())

  projectId String
  name String
  riskProfile String?
  businessCriticality String?
  dataClassification String?
  internetFacing Boolean @default(false)
  authRequired Boolean @default(false)
  notes String?

  project Project @relation(fields: [projectId], references: [id])
  reviews SecurityReview[]
  scopeItems ScopeItem[]
  requiredReviews RequiredReviewType[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ScopeItem {
  id String @id @default(cuid())

  scopeProfileId String
  componentId String?
  name String
  type String @default("URL")
  value String?
  inScope Boolean @default(true)
  notes String?

  scopeProfile ScopeProfile @relation(fields: [scopeProfileId], references: [id])
  component Component? @relation(fields: [componentId], references: [id])
}

model RequiredReviewType {
  id String @id @default(cuid())

  scopeProfileId String
  type String
  required Boolean @default(true)
  reason String?

  scopeProfile ScopeProfile @relation(fields: [scopeProfileId], references: [id])
}

model SecurityReview {
  id String @id @default(cuid())

  srId String? @unique
  projectId String
  scopeProfileId String?

  title String
  type String @default("PENTEST")
  status String @default("Requested")
  priority String @default("Medium")

  requestedStartDate DateTime?
  actualStartDate DateTime?
  dueDate DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  project Project @relation(fields: [projectId], references: [id])
  scopeProfile ScopeProfile? @relation(fields: [scopeProfileId], references: [id])

  workstreams ReviewWorkstream[]
  assignments ReviewerAssignment[]
  findings Finding[]
  extensions ReviewExtension[] @relation("ReviewExtensionRequest")
  relatedExtensions ReviewExtension[] @relation("RelatedReviewExtension")
  cancellation ReviewCancellation?
  activities ReviewActivity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReviewWorkstream {
  id String @id @default(cuid())

  reviewId String
  type String
  status String @default("Not Started")
  required Boolean @default(true)
  notes String?

  review SecurityReview @relation(fields: [reviewId], references: [id])
  assignments ReviewerAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReviewerProfile {
  id String @id @default(cuid())

  userId String @unique
  availability String @default("Available")
  weeklyCapacityHours Int @default(20)
  notes String?

  user User @relation(fields: [userId], references: [id])
  skills ReviewerSkill[]
  assignments ReviewerAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReviewerSkill {
  id String @id @default(cuid())

  reviewerProfileId String
  skill String
  level String @default("Intermediate")

  reviewerProfile ReviewerProfile @relation(fields: [reviewerProfileId], references: [id])

  @@unique([reviewerProfileId, skill])
}

model ReviewerAssignment {
  id String @id @default(cuid())

  reviewId String
  workstreamId String?
  reviewerProfileId String?
  userId String?

  role String @default("Primary")
  status String @default("Assigned")
  allocatedHours Int?
  startDate DateTime?
  endDate DateTime?

  review SecurityReview @relation(fields: [reviewId], references: [id])
  workstream ReviewWorkstream? @relation(fields: [workstreamId], references: [id])
  reviewerProfile ReviewerProfile? @relation(fields: [reviewerProfileId], references: [id])
  user User? @relation("AssignmentUser", fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReviewExtension {
  id String @id @default(cuid())

  reviewId String
  relatedReviewId String?
  requestedUntil DateTime
  reason String
  status String @default("Requested")

  review SecurityReview @relation("ReviewExtensionRequest", fields: [reviewId], references: [id])
  relatedReview SecurityReview? @relation("RelatedReviewExtension", fields: [relatedReviewId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReviewCancellation {
  id String @id @default(cuid())

  reviewId String @unique
  reason String
  status String @default("Requested")
  approvedBy String?

  review SecurityReview @relation(fields: [reviewId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReviewActivity {
  id String @id @default(cuid())

  reviewId String
  action String
  actor String?
  oldValue String?
  newValue String?
  notes String?

  review SecurityReview @relation(fields: [reviewId], references: [id])

  createdAt DateTime @default(now())
}

model RiskException {
  id String @id @default(cuid())

  findingId String
  reason String
  status String @default("Requested")
  expiresAt DateTime?
  approvedBy String?

  finding Finding @relation(fields: [findingId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RemediationPlan {
  id String @id @default(cuid())

  findingId String @unique
  ownerId String?
  summary String?
  status String @default("Planned")
  targetDate DateTime?

  finding Finding @relation(fields: [findingId], references: [id])
  owner User? @relation("RemediationPlanOwner", fields: [ownerId], references: [id])
  tasks Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FindingAnalysis {
  id String @id @default(cuid())

  findingId String @unique

  businessImpact    String?
  technicalImpact   String?
  remediationPlan   String?
  developerGuidance String?
  executiveSummary  String?

  riskScore Int?

  finding Finding @relation(fields: [findingId], references: [id])
}

model FindingActivity {
  id String @id @default(cuid())

  findingId String

  action String

  actor String?

  oldValue String?
  newValue String?

  notes String?

  createdAt DateTime @default(now())

  finding Finding @relation(fields: [findingId], references: [id])
}

model AppSession {
  id String @id @default(cuid())

  currentUserId String

  user User @relation(fields: [currentUserId], references: [id])
}

model KnowledgeDocument {
  id String @id @default(cuid())

  title String

  source String

  content String

  documentType String?

  projectId String?

  reviewId String?

  sprId String?

  srId String?

  iteration String @default("1.0")

  artifactType String @default("Review Artifact")

  scanner String?

  fileName String?

  uploadedById String?

  visibility String @default("REVIEW_TEAM")

  createdAt DateTime @default(now())
}

model CopilotConversation {
  id String @id @default(cuid())

  question String

  answer String

  createdAt DateTime @default(now())
}

model InterviewProfile {
  id String @id @default(cuid())

  candidateCode String @unique
  interviewKind String @default("External")
  name String
  employeeId String?
  currentTeam String?
  currentRole String?
  experience String?
  skills String?
  certifications String?
  currentProject String?
  resumeFileName String?
  linkedIn String?
  source String?
  assignedRecruiterId String?
  hiringManagerId String?
  priority String @default("Medium")
  tags String?
  status String @default("Applied / Nominated")
  aiEnabled Boolean @default(false)

  assignedRecruiter User? @relation("InterviewRecruiter", fields: [assignedRecruiterId], references: [id])
  hiringManager User? @relation("InterviewHiringManager", fields: [hiringManagerId], references: [id])
  rounds InterviewRound[]
  capabilities InterviewCapability[]
  actions InterviewAction[]
  audits InterviewAudit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InterviewRound {
  id String @id @default(cuid())

  profileId String
  category String @default("Mock Interview")
  stage String @default("Mock Interview Scheduled")
  status String @default("Scheduled")
  ownerId String?
  primaryInterviewerId String?
  secondaryInterviewerId String?
  observerId String?
  scheduledAt DateTime?
  completedAt DateTime?
  durationMinutes Int?
  meetingLink String?
  comments String?
  attachments String?

  profile InterviewProfile @relation(fields: [profileId], references: [id])
  owner User? @relation("InterviewOwner", fields: [ownerId], references: [id])
  primaryInterviewer User? @relation("PrimaryInterviewer", fields: [primaryInterviewerId], references: [id])
  secondaryInterviewer User? @relation("SecondaryInterviewer", fields: [secondaryInterviewerId], references: [id])
  observer User? @relation("ObserverInterviewer", fields: [observerId], references: [id])
  feedback InterviewFeedback?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InterviewFeedback {
  id String @id @default(cuid())

  roundId String @unique
  technicalKnowledge Int @default(0)
  communication Int @default(0)
  problemSolving Int @default(0)
  securityFundamentals Int @default(0)
  webApplicationSecurity Int @default(0)
  apiSecurity Int @default(0)
  burpSuite Int @default(0)
  owasp Int @default(0)
  cloudSecurity Int @default(0)
  aiLlmSecurity Int @default(0)
  documentation Int @default(0)
  overallConfidence Int @default(0)
  strengths String?
  areasForImprovement String?
  additionalNotes String?
  recommendedLearning String?
  finalRecommendation String @default("Borderline")

  round InterviewRound @relation(fields: [roundId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InterviewCapability {
  id String @id @default(cuid())

  profileId String
  technology String
  rating String @default("Beginner")

  profile InterviewProfile @relation(fields: [profileId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, technology])
}

model InterviewAction {
  id String @id @default(cuid())

  profileId String
  actionType String
  ownerId String?
  dueDate DateTime?
  status String @default("Open")
  notes String?

  profile InterviewProfile @relation(fields: [profileId], references: [id])
  owner User? @relation("InterviewActionOwner", fields: [ownerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InterviewAudit {
  id String @id @default(cuid())

  profileId String
  user String?
  action String
  fieldChanged String?
  previousValue String?
  newValue String?

  profile InterviewProfile @relation(fields: [profileId], references: [id])

  createdAt DateTime @default(now())
}

model Account {
  id String @id @default(cuid())

  userId String @unique

  passwordHash String

  user User @relation(fields: [userId], references: [id])
}
