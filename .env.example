# Neon Postgres connection string:
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/atomix?sslmode=require"

# V1 local/dev Ollama default:
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen3:8b"
OLLAMA_API_KEY="replace-with-a-long-random-token"

# V1 live pattern for Vercel:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/atomix?sslmode=require"
# OLLAMA_BASE_URL="https://your-secure-ai-tunnel.example.com"
# OLLAMA_MODEL="qwen3:8b"
# OLLAMA_API_KEY="same-token-as-your-local-ai-server"

# Local AI server wrapper around Ollama:
AI_SERVER_PORT="8787"
OLLAMA_UPSTREAM_URL="http://localhost:11434"

# SQLite export helper for one-time migration:
LOCAL_SQLITE_PATH="prisma/atomix.db"
ATOMIX_EXPORT_PATH="atomix-sqlite-export.json"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-me"

# Streamable HTTP MCP endpoint at /api/mcp:
ATOMIX_MCP_TOKEN="replace-with-a-long-random-token"
ATOMIX_MCP_ALLOWED_ORIGINS="https://your-atomix-domain.example.com"
ATOMIX_MCP_RATE_LIMIT_PER_MINUTE="60"
